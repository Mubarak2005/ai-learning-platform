# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- Security ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_learning_platform

# --- CORS (comma-separated list is parsed as JSON array by pydantic-settings; use default in code if unset) ---
# CORS_ORIGINS=["http://localhost:5173"]

# --- AI Provider (provider-agnostic; swap without touching call sites) ---
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- iGOT Karmayogi integration ---
IGOT_MODE=mock
IGOT_BASE_URL=
IGOT_API_KEY=

# --- NSSTA / TPAC integration ---
NSSTA_MODE=mock
NSSTA_BASE_URL=
